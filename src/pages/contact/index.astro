---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { site } from '../../data/site';

const title = `Contact | ${site.name}`;
const description = `Contact ${site.name} in ${site.address.locality}, Ontario. Licensed plumbers and gas-certified HVAC technicians for Goderich and Huron County. Office ${site.phone.display}, ${site.hours.emergency.toLowerCase()}.`;

const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact/` },
  ],
});
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.address.street}, ${site.address.locality}, ${site.address.region} ${site.address.postal}`)}`;
---
<Base title={title} description={description} path="/contact/" active="contact" schemaBlocks={[breadcrumb]}>

  <section class="section">
    <div class="container">
      <nav class="pillar-detail__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span>
      </nav>
      <span class="eyebrow">Get in touch</span>
      <h1>Talk to a licensed plumber</h1>
      <p class="lede" style="max-width:60ch">Send a few details and we will call you back, usually within the hour during office hours. For a flood, a no-heat call, or a gas smell, call the 24-hour emergency line directly.</p>
    </div>
  </section>

  <section class="section contact" style="padding-top:0">
    <div class="container contact__grid">
      <div class="contact__intro reveal">
        <h2>By phone or email</h2>
        <a class="contact__phone" href={`tel:${site.phone.tel}`}><Icon name="phone" size={20} /> {site.phone.display}</a>
        <p style="margin-top:18px"><a href={`mailto:${site.email}`} style="font-weight:600">{site.email}</a></p>
        <p class="contact__hours"><b>Office</b><br />{site.hours.weekdays}<br />{site.hours.saturday}<br />{site.hours.sunday}<br /><b>Emergency line</b><br /><a href={`tel:${site.phoneEmergency.tel}`} style="font-weight:600">{site.phoneEmergency.display}</a> &middot; {site.hours.emergency}<br /><b>Fax</b><br />{site.phoneFax.display}</p>
        <div class="contact__proof">
          <span><Icon name="mapPin" size={16} /> {site.address.street}, {site.address.locality}, {site.address.region} {site.address.postal}</span>
          <span><Icon name="check" size={16} /> Licensed plumbing, heating &amp; cooling contractor</span>
          <span><Icon name="check" size={16} /> Gas-certified (NG &amp; LP)</span>
          <span><Icon name="check" size={16} /> Permit &amp; inspection handled</span>
        </div>
        <p style="margin-top:18px"><a href={mapUrl} target="_blank" rel="noopener">Get directions <Icon name="arrowRight" size={15} /></a></p>
      </div>
      <div class="reveal d1"><QuoteForm id="contact-quote" /></div>
    </div>
  </section>

  <section class="section bg-espresso">
    <div class="container cta-band reveal">
      <h2>Not sure what you need?</h2>
      <p class="lede">Tell us what is going on and we will point you to the right service and the right technician.</p>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href={`tel:${site.phone.tel}`}><Icon name="phone" size={19} /> {site.phone.display}</a>
      </div>
    </div>
  </section>

</Base>
